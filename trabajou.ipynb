   "source": [
    "# Descripción estadística\n",
    "print(\"ESTADÍSTICAS DESCRIPTIVAS:\")\n",
    "print(df.describe())\n",
    "print(\"\\n\" + \"=\"*50 + \"\\n\")\n",
    "\n",
    "# Análisis por columna de edad\n",
    "print(\"ANÁLISIS DE EDAD:\")\n",
    "print(f\"Edad mínima: {df['Age'].min()}\")\n",
    "print(f\"Edad máxima: {df['Age'].max()}\")\n",
    "print(f\"Edad promedio: {df['Age'].mean():.2f}\")\n",
    "print(f\"Desviación estándar: {df['Age'].std():.2f}\")\n",
    "print(\"\\n\" + \"=\"*50 + \"\\n\")\n",
    "\n",
    "# Distribución de Placement Status\n",
    "print(\"DISTRIBUCIÓN DE COLOCACIÓN:\")\n",
    "print(df['Placement_Status'].value_counts())\n",
    "total_colocados = df[df['Placement_Status'] == 'Placed'].shape[0]\n",
    "print(f\"Porcentaje colocados: {(total_colocados / len(df) * 100):.2f}%\")\n",
    "print(\"\\n\" + \"=\"*50 + \"\\n\")\n",
    "\n",
    "# Majores disponibles\n",
    "print(\"MAJORES DISPONIBLES:\")\n",
    "print(df['Major'].value_counts())"
