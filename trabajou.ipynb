   "source": [
    "## 4. Gráfico: Tasa de Colocación por Major"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "65a893ae",
   "metadata": {},
   "outputs": [],
   "source": [
    "placement_by_major = df.groupby(\"Major\")[\"Placement_Status\"].value_counts().unstack(fill_value=0)\n",
    "\n",
    "plt.figure(figsize=(12,6))\n",
    "placement_by_major.plot(kind='bar', ax=plt.gca())\n",
    "plt.title(\"Estado de Colocación por Carrera\")\n",
    "plt.xlabel(\"Carrera\")\n",
    "plt.ylabel(\"Cantidad\")\n",
    "plt.legend(title=\"Estado\")\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
